{
  "expo": {
    "name": "Youplex",
    "slug": "youplex-apk",
    "version": "1.0.1",
    "owner": "steveyout",
    "orientation": "default",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "cc.youplex.movies",
      "versionCode": 31,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#000000"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "WAKE_LOCK",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_DATA_SYNC",
        "POST_NOTIFICATIONS"
      ],
      "isTV": true,
      "banner": "./assets/logo-tv.png",
      "softwareLeanback": true,
      "intentFilters": [
        {
          "action": "MAIN",
          "category": [
            "LAUNCHER",
            "LEANBACK_LAUNCHER"
          ]
        }
      ]
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "extraMavenRepos": ["https://maven.pawns.app"],
            "compileSdkVersion": 34,
            "targetSdkVersion": 34
          }
        }
      ],
      "@react-native-firebase/app",
      "./plugins/withPawnsSDK"
    ],
    "extra": {
      "eas": {
        "projectId": "44f09ad8-a557-4c72-b030-ac02a4088981"
      }
    }
  }
}
