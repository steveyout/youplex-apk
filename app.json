{
  "expo": {
    "name": "Youplex",
    "slug": "youplex-apk",
    "version": "1.0.1",
    "owner": "steveyout",
    "orientation": "default",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "cc.youplex.movies",
      "versionCode": 31,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#000000"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "isTV": true,
      "banner": "./assets/logo-tv.png",
      "softwareLeanback": true,
      "intentFilters": [
        {
          "action": "MAIN",
          "category": [
            "LAUNCHER",
            "LEANBACK_LAUNCHER"
          ]
        }
      ],
      "config": {
        "keyboard": true
      }
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "extraMavenRepos": ["https://maven.pawns.app"]
          }
        }
      ],
      "@react-native-firebase/app",
      "./plugins/withPawnsSDK"
    ],
    "modules": ["./modules/pawns-monetization"],
    "androidNavigationBar": {
      "visible": "sticky-immersive",
      "backgroundColor": "#000000",
      "barStyle": "light-content"
    },
    "extra": {
      "eas": {
        "projectId": "44f09ad8-a557-4c72-b030-ac02a4088981"
      }
    }
  }
}
